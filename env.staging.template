# Configuración para ambiente de STAGING local
# Copia este archivo a .env.staging y ajusta los valores según tu configuración local
#
# Comando para crear el archivo:
# cp env.staging.template .env.staging

# Ambiente de Django
DJANGO_ENVIRONMENT=staging
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=tu-clave-secreta-para-staging-aqui-cambiar

# Configuración de base de datos PostgreSQL local para staging
# Opción 1: Usar DATABASE_URL (recomendado)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bonito_amor_staging

# Opción 2: O usar variables individuales (se usarán si DATABASE_URL no está definido)
# STAGING_DB_NAME=bonito_amor_staging
# STAGING_DB_USER=postgres
# STAGING_DB_PASSWORD=postgres
# STAGING_DB_HOST=localhost
# STAGING_DB_PORT=5432

# Nota: Asegúrate de que PostgreSQL esté instalado y corriendo localmente
# y que la base de datos y el usuario existan antes de usar este ambiente

# API Key de Anthropic (Claude), usada para extraer productos de la foto/PDF
# de una factura de compra en "Importación IA". Conseguir en console.anthropic.com
ANTHROPIC_API_KEY=





